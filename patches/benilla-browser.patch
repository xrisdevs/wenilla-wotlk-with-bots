diff --git a/crates/benilla-app/src/mirror_image.rs b/crates/benilla-app/src/mirror_image.rs
new file mode 100644
index 00000000..293933b0
--- /dev/null
+++ b/crates/benilla-app/src/mirror_image.rs
@@ -0,0 +1,154 @@
+//! Mirror images: a creature flagged `UNIT_FLAG2_MIRROR_IMAGE` (`UNIT_FIELD_FLAGS_2` bit `0x10`)
+//! is drawn as a player body, not as its own creature display. The reference asks
+//! `CMSG_GET_MIRRORIMAGE_DATA` for such a unit as it streams in and keeps the answer on the unit
+//! for its life, asking again only for a re-created object; `SMSG_MIRRORIMAGE_DATA` names the
+//! display to draw, a `PLAYER_BYTES`-shaped look and eleven worn `ItemDisplayInfo` ids. The body
+//! then composes exactly as another player's does ([`crate::entities::attach`]), with the worn
+//! ids in its `Equipment`; weapons stay the unit's own `UNIT_VIRTUAL_ITEM_SLOT_ID`.
+
+use std::collections::HashMap;
+
+use benilla_protocol::messages::MirrorImageData;
+use benilla_protocol::{EntityKind, SessionEvent, SessionEventKind};
+use bevy::prelude::*;
+
+use crate::net::{ClientCommand, GuidIndex, NetCommands, NetEntity, NetHandlerApp};
+
+/// A unit's answered look, on its entity: the body it draws as and the ids it wears.
+#[derive(Component, Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) struct MirrorImage(pub(crate) MirrorImageData);
+
+/// The ask-once state per guid: `None` while the ask is out, the answer once it lands. An entry
+/// lives from the object's create to its destroy or out-of-range, so a refresh-in-place create
+/// asks nothing while a re-create after a destroy asks afresh, as the reference's per-object
+/// data does.
+#[derive(Resource, Default)]
+pub(crate) struct MirrorImages(HashMap<u64, Option<MirrorImageData>>);
+
+/// Register the handlers, from [`crate::net::NetPlugin`], after the object handlers.
+pub(crate) fn register(app: &mut App) {
+    use SessionEventKind as K;
+    app.init_resource::<MirrorImages>();
+    app.net_handler(K::ObjectCreate, on_object_create)
+        .net_handler(K::MirrorImageData, on_mirror_image_data)
+        .net_handler(K::ObjectDestroyed, on_object_gone)
+        .net_handler(K::ObjectsRemoved, on_object_gone)
+        .net_handler(K::Worldport, on_world_left)
+        .net_handler(K::Disconnected, on_world_left)
+        .net_handler(K::LoggedOut, on_world_left);
+}
+
+/// A flagged unit's create: ask once per object. A re-create of a live object re-stamps its
+/// [`NetEntity`] from the wire, so the answered display is put back on it.
+fn on_object_create(
+    In(ev): In<SessionEvent>,
+    mut asked: ResMut<MirrorImages>,
+    net: Res<NetCommands>,
+    index: Res<GuidIndex>,
+    mut nets: Query<&mut NetEntity>,
+) {
+    let SessionEvent::ObjectCreate {
+        guid,
+        kind: EntityKind::Unit,
+        fields,
+        ..
+    } = ev
+    else {
+        return;
+    };
+    if !fields.unit_is_mirror_image() {
+        return;
+    }
+    match asked.0.get(&guid) {
+        None => {
+            debug!("mirror image: guid {guid:#x} streamed in flagged; asking for its look");
+            asked.0.insert(guid, None);
+            let _ = net.0.send(ClientCommand::GetMirrorImageData { guid });
+        }
+        Some(Some(data)) => {
+            if let Some(mut net) = index.0.get(&guid).and_then(|&e| nets.get_mut(e).ok()) {
+                apply_display(&mut net, data);
+            }
+        }
+        Some(None) => {} // asked, answer pending
+    }
+}
+
+/// The answer: kept for the guid, and put on the unit's entity, whose visual the entities layer
+/// rebuilds from it.
+fn on_mirror_image_data(
+    In(ev): In<SessionEvent>,
+    mut commands: Commands,
+    mut asked: ResMut<MirrorImages>,
+    index: Res<GuidIndex>,
+    mut nets: Query<&mut NetEntity>,
+) {
+    let SessionEvent::MirrorImageData(data) = ev else {
+        return;
+    };
+    asked.0.insert(data.guid, Some(data));
+    let Some(&entity) = index.0.get(&data.guid) else {
+        debug!("mirror image: guid {:#x} answered after it left", data.guid);
+        return;
+    };
+    let Ok(mut net) = nets.get_mut(entity) else {
+        return;
+    };
+    // Only a unit asks; an unsolicited answer for anything else is dropped.
+    if net.kind != EntityKind::Unit {
+        return;
+    }
+    apply_display(&mut net, &data);
+    info!(
+        "mirror image: guid {:#x} drawn as display {} race {} gender {} class {} \
+         look [{}, {}, {}, {}, {}] guild {} items {:?}",
+        data.guid,
+        data.display_id,
+        data.race,
+        data.gender,
+        data.class,
+        data.skin,
+        data.face,
+        data.hair,
+        data.hair_color,
+        data.facial_hair,
+        data.guild_id,
+        data.items
+    );
+    commands.entity(entity).insert(MirrorImage(data));
+}
+
+/// The display the answer names replaces the unit's own, when it names one; written only on a
+/// change so the entity's change flag stays meaningful.
+fn apply_display(net: &mut Mut<NetEntity>, data: &MirrorImageData) {
+    if data.display_id != 0 && net.display_id != Some(data.display_id) {
+        net.display_id = Some(data.display_id);
+    }
+}
+
+/// A destroyed or out-of-range object drops its entry: a later create of the guid asks afresh.
+fn on_object_gone(In(ev): In<SessionEvent>, mut asked: ResMut<MirrorImages>) {
+    match ev {
+        SessionEvent::ObjectDestroyed(guid) => {
+            asked.0.remove(&guid);
+        }
+        SessionEvent::ObjectsRemoved(guids) => {
+            for guid in guids {
+                asked.0.remove(&guid);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Every streamed object is purged with the world, and so is every ask.
+fn on_world_left(In(ev): In<SessionEvent>, mut asked: ResMut<MirrorImages>) {
+    if matches!(
+        ev,
+        SessionEvent::Worldport { .. }
+            | SessionEvent::Disconnected { .. }
+            | SessionEvent::LoggedOut
+    ) {
+        asked.0.clear();
+    }
+}
