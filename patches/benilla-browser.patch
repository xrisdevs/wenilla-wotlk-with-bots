+    body.extend_from_slice(&19723u32.to_le_bytes()); // displayId
+    body.extend_from_slice(&[1, 0, 6, 3, 4, 5, 7, 2]); // race, gender, class, skin … facialhair
+    body.extend_from_slice(&0u32.to_le_bytes()); // guildId
+    for id in [100u32, 101, 0, 103, 104, 105, 106, 107, 108, 109, 0] {
