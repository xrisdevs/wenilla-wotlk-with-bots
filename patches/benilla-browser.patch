diff --git a/crates/benilla-protocol/src/messages/mirror_image.rs b/crates/benilla-protocol/src/messages/mirror_image.rs
new file mode 100644
index 00000000..49fc0108
--- /dev/null
+++ b/crates/benilla-protocol/src/messages/mirror_image.rs
@@ -0,0 +1,83 @@
+//! Mirror images: a creature flagged `UNIT_FLAG2_MIRROR_IMAGE` (`UNIT_FIELD_FLAGS_2` bit 4) is
+//! drawn as a player body, not its own `CreatureDisplayInfoExtra` look. The client asks
+//! `CMSG_GET_MIRRORIMAGE_DATA` for the unit and dresses it from `SMSG_MIRRORIMAGE_DATA`: the
+//! player model of (race, gender) with a `PLAYER_BYTES`-shaped customization, wearing eleven
+//! `ItemDisplayInfo` ids. Weapons stay the unit's own `UNIT_VIRTUAL_ITEM_SLOT_ID`.
+
+use std::io::{self, Read};
+
+use crate::wire::{read_u32_le, read_u64_le, read_u8};
+
+/// The number of worn display ids on the wire, `EQUIPMENT_SLOT_HEAD` to `_TABARD` less the slots
+/// nothing shows (neck, rings, trinkets, weapons).
+pub const MIRROR_IMAGE_ITEMS: usize = 11;
+
+/// `SMSG_MIRRORIMAGE_DATA` (68 bytes, TrinityCore `SpellHandler.cpp` `HandleMirrorImageDataRequest`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MirrorImageData {
+    pub guid: u64,
+    /// The `CreatureDisplayInfo` id to draw: the creator's, or a bot's own; 0 keeps the unit's.
+    pub display_id: u32,
+    pub race: u8,
+    pub gender: u8,
+    pub class: u8,
+    /// skinColor, faceType, hairStyle, hairColor and facialHair, `PLAYER_BYTES`' bytes 0 to 3
+    /// and `PLAYER_BYTES_2` byte 0 of the body copied.
+    pub skin: u8,
+    pub face: u8,
+    pub hair: u8,
+    pub hair_color: u8,
+    pub facial_hair: u8,
+    /// The tabard's guild, 0 for none.
+    pub guild_id: u32,
+    /// `ItemDisplayInfo` ids in wire order: head, shoulders, body (shirt), chest, waist, legs,
+    /// feet, wrists, hands, back (cloak), tabard; 0 is an empty slot.
+    pub items: [u32; MIRROR_IMAGE_ITEMS],
+}
+
+impl MirrorImageData {
+    pub const HEAD: usize = 0;
+    pub const SHOULDERS: usize = 1;
+    pub const BODY: usize = 2;
+    pub const CHEST: usize = 3;
+    pub const WAIST: usize = 4;
+    pub const LEGS: usize = 5;
+    pub const FEET: usize = 6;
+    pub const WRISTS: usize = 7;
+    pub const HANDS: usize = 8;
+    pub const BACK: usize = 9;
+    pub const TABARD: usize = 10;
+}
+
+/// Read an `SMSG_MIRRORIMAGE_DATA` body.
+pub fn read_mirror_image_data(r: &mut impl Read) -> io::Result<MirrorImageData> {
+    let guid = read_u64_le(r)?;
+    let display_id = read_u32_le(r)?;
+    let race = read_u8(r)?;
+    let gender = read_u8(r)?;
+    let class = read_u8(r)?;
+    let skin = read_u8(r)?;
+    let face = read_u8(r)?;
+    let hair = read_u8(r)?;
+    let hair_color = read_u8(r)?;
+    let facial_hair = read_u8(r)?;
+    let guild_id = read_u32_le(r)?;
+    let mut items = [0u32; MIRROR_IMAGE_ITEMS];
+    for item in &mut items {
+        *item = read_u32_le(r)?;
+    }
+    Ok(MirrorImageData {
+        guid,
+        display_id,
+        race,
+        gender,
+        class,
+        skin,
+        face,
+        hair,
+        hair_color,
+        facial_hair,
+        guild_id,
+        items,
+    })
+}
