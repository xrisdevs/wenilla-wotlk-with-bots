+uint32 BotDataMgr::GetArenaBotCapacity(uint8 botClass, uint32 team, uint8 level)
+{
+    (void)sBotGen; // Initialize the free-template pool before the first admission check.
+    auto itr = _spareBotIdsPerClassMap.find(botClass);
+    if (itr == _spareBotIdsPerClassMap.end() || GetMinLevelForBotClass(botClass) > level)
+        return 0;
+    uint32 count = 0;
+    for (uint32 entry : itr->second)
+        if (NpcBotExtras const* extras = SelectNpcBotExtras(entry))
+            if (GetTeamForFaction(GetDefaultFactionForBotRaceClass(extras->bclass, extras->race)) == team)
+                ++count;
+    return count;
+}
